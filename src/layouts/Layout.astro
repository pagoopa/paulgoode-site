---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';
import '../styles/prose.css';

interface Props {
  title: string;
  description?: string;
  // The blog sidebar: beside the content on desktop, below it on smaller screens.
  sidebar?: boolean;
  // og:type: "website" for pages, "article" for a journal post.
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Paul Goode — UX designer, artist, and musician. Drawing is thinking.',
  sidebar = false,
  ogType = 'website',
} = Astro.props;

// Address of this page and of the share image, for search results and link previews.
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} | Paul Goode</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Paul Goode — Journal" href="/rss.xml" />
    <meta property="og:site_name" content="Paul Goode" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={`${title} | Paul Goode`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Paul Goode: Drawing is thinking." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <div class:list={['page', { 'page--sidebar': sidebar }]}>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      {sidebar && <Sidebar />}
    </div>
    <Footer />
  </body>
</html>

<style>
  /* Content on the left, the sidebar (300 wide) on the right, as tall as the content. */
  .page--sidebar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
  }

  /* The sidebar runs down to the footer. */
  .page--sidebar + :global(.site-footer) {
    margin-top: 0;
  }

  /* The content area is 24 from each side, as on the boards. */
  @media (min-width: 1024px) {
    .page--sidebar :global(.wrap) {
      padding-inline: var(--scale-0600);
    }
  }

  /* Tablet and phones: the sidebar moves below the content. */
  @media (max-width: 1023px) {
    .page--sidebar {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
