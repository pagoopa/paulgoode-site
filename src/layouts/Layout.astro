---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';
import '../styles/prose.css';
import type { SidebarSection } from '../lib/labels';
import { getSidebarSections } from '../lib/sidebar';

interface Props {
  title: string;
  description?: string;
  // The sidebar: beside the content on desktop, below it on smaller screens. On by default;
  // a page can turn it off, or hide some of its sections (About, Categories, Tags, Newsletter).
  sidebar?: boolean;
  sidebarHide?: SidebarSection[];
  // og:type: "website" for pages, "article" for a journal post.
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Paul Goode — UX designer, artist, and musician. Drawing is thinking.',
  sidebar = true,
  sidebarHide = [],
  ogType = 'website',
} = Astro.props;

// Address of this page and of the share image, for search results and link previews.
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/og-image.png', Astro.site);

// The sections left after the page's own settings and the ones that link to this page.
const sidebarSections = getSidebarSections(Astro.url.pathname, sidebarHide);
const showSidebar = sidebar && sidebarSections.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // `js` lets the entrance motion hide things only when the script that shows them will run.
      // `decor-intro` marks the first page load of a visit: the header decorations draw in then,
      // and not again on every page after.
      document.documentElement.classList.add('js');
      try {
        if (!sessionStorage.getItem('decor-seen')) {
          sessionStorage.setItem('decor-seen', '1');
          document.documentElement.classList.add('decor-intro');
        }
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} | Paul Goode</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Paul Goode — Journal" href="/rss.xml" />
    <meta property="og:site_name" content="Paul Goode" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={`${title} | Paul Goode`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Paul Goode: Drawing is thinking." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <div class:list={['page', { 'page--sidebar': showSidebar }]}>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      {showSidebar && <Sidebar sections={sidebarSections} />}
    </div>
    <Footer />
  </body>
</html>

<style>
  /* Content on the left, the sidebar (300 wide) on the right, as tall as the content. */
  .page--sidebar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
  }

  /* Between 1024 and 1279 the sidebar leaves the content narrow, so card grids use two columns. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .page--sidebar :global(.projects__grid),
    .page--sidebar :global(.series-landing__grid) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* The sidebar runs down to the footer. */
  .page--sidebar + :global(.site-footer) {
    margin-top: 0;
  }

  /* The content area is 24 from each side, as on the boards. */
  @media (min-width: 1024px) {
    .page--sidebar :global(.wrap) {
      padding-inline: var(--scale-0600);
    }
  }

  /* Tablet and phones: the sidebar moves below the content. */
  @media (max-width: 1023px) {
    .page--sidebar {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
