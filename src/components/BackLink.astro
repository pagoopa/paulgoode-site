---
// Link / Back (design/site.pen): a standalone link with the arrow before the label,
// like the Newer link in Pagination. "Back to Projects", "Back to Series".
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="link-standalone" {href}>
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path d="M19 12H5m6 6-6-6 6-6" />
  </svg>
  <span class="link-label">{label}</span>
</a>
