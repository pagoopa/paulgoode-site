---
import { Image } from 'astro:assets';
import logo from '../assets/pg-main.png';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/shop', label: 'Shop' },
  { href: '/blog', label: 'Journal' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Paul Goode — home">
      <Image src={logo} alt="Paul Goode" height={59} densities={[1, 2]} loading="eager" />
    </a>
    <nav class="site-header__nav" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['site-header__link', { 'is-active': isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 24px;
    gap: 24px;
  }

  .site-header__logo {
    display: block;
    flex: none;
  }

  .site-header__logo img {
    width: auto;
    height: 59px;
  }

  .site-header__nav {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    font-size: var(--text-ui);
  }

  .site-header__link.is-active {
    color: var(--color-accent);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .site-header__inner {
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }

    .site-header__logo img {
      height: 54px;
    }

    .site-header__nav {
      gap: 20px;
    }
  }
</style>
