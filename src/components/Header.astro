---
import { Image } from 'astro:assets';
import logo from '../assets/pg-main.png';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/shop', label: 'Shop' },
  { href: '/blog', label: 'Journal' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Paul Goode — home">
      <Image src={logo} alt="Paul Goode" height={59} densities={[1, 2]} loading="eager" />
    </a>
    <nav class="site-header__nav" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['site-header__link', { 'is-active': isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  /* Header / Left / Default */
  .site-header {
    background: var(--color-surface-default);
    border-bottom: 1px solid var(--color-border-default);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--scale-400);
    gap: var(--scale-600);
  }

  .site-header__logo {
    display: block;
    flex: none;
  }

  .site-header__logo img {
    width: auto;
    height: 40px;
  }

  /* Link / Nav: Body/eyebrow2-md, current page underlined */
  .site-header__nav {
    display: flex;
    gap: var(--scale-600);
    flex-wrap: wrap;
    font-size: var(--type-eyebrow2-size);
    line-height: var(--type-eyebrow2-line-height);
    letter-spacing: var(--type-eyebrow2-letter-spacing);
    text-transform: uppercase;
    font-weight: 500;
  }

  .site-header__link {
    padding-block: var(--scale-200);
    border-bottom: 2px solid transparent;
  }

  .site-header__link.is-active {
    border-bottom-color: var(--color-text-default);
  }

  @media (max-width: 599px) {
    .site-header__inner {
      flex-direction: column;
      align-items: center;
      gap: var(--scale-200);
    }

    .site-header__nav {
      gap: var(--scale-400);
    }
  }
</style>
