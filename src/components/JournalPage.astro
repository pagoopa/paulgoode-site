---
// One page of the journal, which is also the home page: the newest posts
// first, POSTS_PER_PAGE at a time, with Newer / Older links. Used by / and
// /blog/page/<n>. Matches the Blog Landing boards in design/site.pen.
import Layout from '../layouts/Layout.astro';
import PostExcerpt from './PostExcerpt.astro';
import Pagination from './Pagination.astro';
import { render } from 'astro:content';
import { getJournalPosts, journalPageUrl, postDateFormat, POSTS_PER_PAGE } from '../lib/blog';

interface Props {
  page: number;
}

const { page } = Astro.props;
const allPosts = await getJournalPosts();
const pageCount = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const posts = allPosts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE);
const entries = await Promise.all(
  posts.map(async (post) => ({ post, Content: (await render(post)).Content }))
);
---

<Layout title={page === 1 ? 'Journal' : `Journal — Page ${page}`}>
  <section class="wrap journal">
    <h1 class="sr-only">Paul Goode — Journal</h1>

    <div class="entry-column">
      {posts.length === 0 && <p class="prose">Nothing published yet.</p>}

      <ul class="journal__list">
        {entries.map(({ post, Content }) => (
          <li class="entry">
            <h2 class="entry__title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <time class="entry__date" datetime={post.data.pubDate.toISOString()}>
              {postDateFormat.format(post.data.pubDate)}
            </time>
            <div class="entry__body">
              <PostExcerpt href={`/blog/${post.id}/`}>
                <Content />
              </PostExcerpt>
            </div>
          </li>
        ))}
      </ul>

      <Pagination
        newer={page > 1 ? journalPageUrl(page - 1) : undefined}
        older={page < pageCount ? journalPageUrl(page + 1) : undefined}
      />
    </div>
  </section>
</Layout>

<style>
  .journal {
    padding-block: var(--scale-0600) var(--space-section);
  }

  .journal__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--scale-0400);
  }
</style>
