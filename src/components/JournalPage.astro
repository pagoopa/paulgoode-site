---
// One page of a list of journal posts: the newest first, POSTS_PER_PAGE at a
// time, with Newer / Older links. By default it's the whole journal, which is
// also the home page (/ and /blog/page/<n>). A category or tag page passes
// its own posts, page links and heading. Matches the Blog Landing boards in
// design/site.pen.
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostExcerpt from './PostExcerpt.astro';
import Pagination from './Pagination.astro';
import SectionHeader from './SectionHeader.astro';
import TagChip from './TagChip.astro';
import { render } from 'astro:content';
import { getJournalPosts, journalPageUrl, postDateFormat, POSTS_PER_PAGE } from '../lib/blog';
import { categoryLabel, categoryUrl } from '../lib/taxonomy';

interface Props {
  page: number;
  /** The posts to list. Defaults to every published post. */
  posts?: CollectionEntry<'blog'>[];
  /** The URL of page n. Defaults to the home page and /blog/page/<n>. */
  pageUrl?: (page: number) => string;
  /** A visible page heading. Without it the page has a hidden h1. */
  heading?: { eyebrow: string; title: string; intro: string };
  title?: string;
  emptyText?: string;
}

const { page, heading, emptyText = 'Nothing published yet.' } = Astro.props;
const allPosts = Astro.props.posts ?? (await getJournalPosts());
const pageUrl = Astro.props.pageUrl ?? journalPageUrl;
const title = Astro.props.title ?? (page === 1 ? 'Journal' : `Journal — Page ${page}`);
const pageCount = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const posts = allPosts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE);
const entries = await Promise.all(
  posts.map(async (post) => ({ post, Content: (await render(post)).Content }))
);
---

<Layout title={title}>
  <section class="wrap journal">
    {!heading && <h1 class="sr-only">Paul Goode — Journal</h1>}

    <div class="entry-column">
      {heading && <SectionHeader eyebrow={heading.eyebrow} title={heading.title} intro={heading.intro} level="h1" />}

      {posts.length === 0 && <p class="prose">{emptyText}</p>}

      <ul class="journal__list">
        {entries.map(({ post, Content }) => (
          <li class="entry">
            <h2 class="entry__title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <div class="entry__meta">
              <time class="entry__date" datetime={post.data.pubDate.toISOString()}>
                {postDateFormat.format(post.data.pubDate)}
              </time>
              <TagChip kind="category" href={categoryUrl(post.data.category)}>
                {categoryLabel(post.data.category)}
              </TagChip>
            </div>
            <div class="entry__body">
              <PostExcerpt href={`/blog/${post.id}/`}>
                <Content />
              </PostExcerpt>
            </div>
          </li>
        ))}
      </ul>

      <Pagination
        newer={page > 1 ? pageUrl(page - 1) : undefined}
        older={page < pageCount ? pageUrl(page + 1) : undefined}
      />
    </div>
  </section>
</Layout>

<style>
  .journal {
    padding-block: var(--scale-0600) var(--space-section);
  }

  .journal__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--scale-0400);
  }
</style>
