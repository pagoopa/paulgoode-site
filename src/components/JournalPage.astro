---
// One page of a list of journal posts as cards: the newest first as a wide lead card,
// then two columns, POSTS_PER_PAGE at a time, with Newer / Older links. By default it's the whole journal, which is
// also the home page (/ and /blog/page/<n>). A category or tag page passes
// its own posts, page links and heading. Matches the Blog Landing boards in
// design/site.pen.
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';
import SectionHeader from './SectionHeader.astro';
import { getJournalPosts, journalPageUrl, postDateFormat, postSummary, POSTS_PER_PAGE } from '../lib/blog';
import { categoryLabel } from '../lib/taxonomy';

interface Props {
  page: number;
  /** The posts to list. Defaults to every published post. */
  posts?: CollectionEntry<'blog'>[];
  /** The URL of page n. Defaults to the home page and /blog/page/<n>. */
  pageUrl?: (page: number) => string;
  /** A visible page heading. Without it the page has a hidden h1. */
  heading?: { eyebrow: string; title: string; intro: string };
  title?: string;
  emptyText?: string;
}

const { page, heading, emptyText = 'Nothing published yet.' } = Astro.props;
const allPosts = Astro.props.posts ?? (await getJournalPosts());
const pageUrl = Astro.props.pageUrl ?? journalPageUrl;
const title = Astro.props.title ?? (page === 1 ? 'Journal' : `Journal — Page ${page}`);
const pageCount = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const posts = allPosts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE);
---

<Layout title={title}>
  <section class="wrap journal">
    {!heading && <h1 class="sr-only">Paul Goode — Journal</h1>}

    <div class="entry-column">
      {heading && <SectionHeader eyebrow={heading.eyebrow} title={heading.title} intro={heading.intro} level="h1" />}

      {posts.length === 0 && <p class="prose">{emptyText}</p>}

      <script is:inline>
        document.documentElement.classList.add('js');
      </script>
      <ul class="journal__list">
        {posts.map((post, i) => (
          <li class:list={['journal__item', { 'journal__item--lead': i === 0 }]}>
            <PostCard
              href={`/blog/${post.id}/`}
              date={post.data.pubDate}
              dateText={postDateFormat.format(post.data.pubDate)}
              category={categoryLabel(post.data.category)}
              title={post.data.title}
              summary={postSummary(post)}
              image={post.data.thumbnail}
              lead={i === 0}
              loading={i < 3 ? 'eager' : 'lazy'}
            />
          </li>
        ))}
      </ul>

      <Pagination
        newer={page > 1 ? pageUrl(page - 1) : undefined}
        older={page < pageCount ? pageUrl(page + 1) : undefined}
      />
    </div>
  </section>
</Layout>

<script>
  // Cards rise and fade in as they scroll into view, one after another (the lead first), and
  // images fade in once loaded. The `js` class (set above the list) is what hides them, so
  // without JavaScript, or with reduced motion, everything is simply visible.
  const items = document.querySelectorAll<HTMLElement>('.journal__item');
  const images = document.querySelectorAll<HTMLImageElement>('.post-card__image');

  images.forEach((img) => {
    const show = () => img.classList.add('is-loaded');
    if (img.complete) show();
    else img.addEventListener('load', show, { once: true });
  });

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        // Cards that come into view together are staggered 60ms apart.
        entries
          .filter((entry) => entry.isIntersecting)
          .forEach((entry, i) => {
            const card = entry.target as HTMLElement;
            card.style.transitionDelay = `${i * 60}ms`;
            card.classList.add('is-in');
            observer.unobserve(card);
          });
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    items.forEach((item) => observer.observe(item));
  } else {
    items.forEach((item) => item.classList.add('is-in'));
  }
</script>

<style>
  .journal {
    padding-block: var(--scale-0600) var(--space-section);
  }

  /* The lead card spans the width; the rest sit in two columns, one on phones. */
  .journal__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--scale-0600);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .journal__item {
    display: flex;
  }

  .journal__item > :global(.post-card) {
    flex: 1;
  }

  .journal__item--lead {
    grid-column: 1 / -1;
  }

  @media (max-width: 599px) {
    .journal__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Loading: cards start 12px low and see-through, then rise in (see the script below). The
     animation is a safety net: if the script never runs, they appear after 2s anyway. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .journal__item:not(.is-in) {
      opacity: 0;
      transform: translateY(12px);
      animation: reveal-fallback 0s 2s forwards;
    }

    .journal__item {
      transition:
        opacity 360ms ease-out,
        transform 360ms ease-out;
    }

    :global(html.js .post-card__image:not(.is-loaded)) {
      opacity: 0;
      animation: reveal-fallback 0s 2s forwards;
    }

    :global(html.js .post-card__image) {
      transition:
        opacity 300ms ease-out,
        transform 400ms ease-out;
    }
  }

  @keyframes reveal-fallback {
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
