---
// One page of the journal: the newest posts first, POSTS_PER_PAGE at a time,
// with Newer / Older links. Used by /blog and /blog/page/<n>.
import Layout from '../layouts/Layout.astro';
import PostExcerpt from './PostExcerpt.astro';
import Pagination from './Pagination.astro';
import { render } from 'astro:content';
import { getJournalPosts, journalPageUrl, POSTS_PER_PAGE } from '../lib/blog';

interface Props {
  page: number;
}

const { page } = Astro.props;
const allPosts = await getJournalPosts();
const pageCount = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const posts = allPosts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE);
const entries = await Promise.all(
  posts.map(async (post) => ({ post, Content: (await render(post)).Content }))
);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  // pubDate is midnight UTC; without this it shows the day before in US time zones.
  timeZone: 'UTC',
});
---

<Layout
  title={page === 1 ? 'Journal' : `Journal — Page ${page}`}
  description="Keep Going Sketchbook — an open creative journal."
>
  <section class="wrap journal">
    <p class="eyebrow">Journal</p>
    <h1>Keep Going Sketchbook</h1>

    {posts.length === 0 && <p class="prose">Nothing published yet.</p>}

    <ul class="journal__list">
      {entries.map(({ post, Content }) => (
        <li class="journal__item">
          <span class="journal__date">{dateFmt.format(post.data.pubDate)}</span>
          <h2 class="journal__title">
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </h2>
          <div class="journal__body">
            <PostExcerpt href={`/blog/${post.id}/`}>
              <Content />
            </PostExcerpt>
          </div>
        </li>
      ))}
    </ul>

    <Pagination
      newer={page > 1 ? journalPageUrl(page - 1) : undefined}
      older={page < pageCount ? journalPageUrl(page + 1) : undefined}
    />
  </section>
</Layout>

<style>
  .journal {
    padding-block: 64px 96px;
    max-width: 720px;
  }

  .journal__list {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .journal__item {
    padding-block: var(--scale-0600);
    border-bottom: 1px solid var(--color-border-default);
  }

  /* Body/eyebrow3-md, as on Card / Post */
  .journal__date {
    font-size: var(--type-eyebrow3-size);
    line-height: var(--type-eyebrow3-line-height);
    letter-spacing: var(--type-eyebrow3-letter-spacing);
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  /* Headings/Header 4 */
  .journal__title {
    font-size: var(--type-h4-size);
    line-height: var(--type-h4-line-height);
    margin: var(--scale-0200) 0 var(--scale-0200);
  }

  /* Same body text as the post page */
  .journal__body {
    font-size: var(--type-p2-size);
    line-height: var(--type-p2-line-height);
  }

  .journal__body :global(p) {
    margin-bottom: 1.4em;
  }

  .journal__body :global(img) {
    height: auto;
  }
</style>
