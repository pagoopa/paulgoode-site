---
// One page of a list of journal posts as cards: the newest first as a wide lead card,
// then two columns, POSTS_PER_PAGE at a time, with Newer / Older links. By default it's the whole journal, which is
// also the home page (/ and /blog/page/<n>). A category or tag page passes
// its own posts, page links and heading. Matches the Blog Landing boards in
// design/site.pen.
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';
import SectionHeader from './SectionHeader.astro';
import { getJournalPosts, journalPageUrl, postDateFormat, postSummary, POSTS_PER_PAGE } from '../lib/blog';
import { categoryLabel } from '../lib/taxonomy';

interface Props {
  page: number;
  /** The posts to list. Defaults to every published post. */
  posts?: CollectionEntry<'blog'>[];
  /** The URL of page n. Defaults to the home page and /blog/page/<n>. */
  pageUrl?: (page: number) => string;
  /** A visible page heading. Without it the page has a hidden h1. */
  heading?: { eyebrow: string; title: string; intro: string };
  title?: string;
  emptyText?: string;
}

const { page, heading, emptyText = 'Nothing published yet.' } = Astro.props;
const allPosts = Astro.props.posts ?? (await getJournalPosts());
const pageUrl = Astro.props.pageUrl ?? journalPageUrl;
const title = Astro.props.title ?? (page === 1 ? 'Journal' : `Journal — Page ${page}`);
const pageCount = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const posts = allPosts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE);
---

<Layout title={title}>
  <section class="wrap journal">
    {!heading && <h1 class="sr-only">Paul Goode — Journal</h1>}

    <div class="entry-column">
      {heading && <SectionHeader eyebrow={heading.eyebrow} title={heading.title} intro={heading.intro} level="h1" />}

      {posts.length === 0 && <p class="prose">{emptyText}</p>}

      <ul class="journal__list">
        {posts.map((post, i) => (
          <li class:list={['journal__item', { 'journal__item--lead': i === 0 }]}>
            <PostCard
              href={`/blog/${post.id}/`}
              date={post.data.pubDate}
              dateText={postDateFormat.format(post.data.pubDate)}
              category={categoryLabel(post.data.category)}
              title={post.data.title}
              summary={postSummary(post)}
              image={post.data.thumbnail}
              lead={i === 0}
              loading={i < 3 ? 'eager' : 'lazy'}
            />
          </li>
        ))}
      </ul>

      <Pagination
        newer={page > 1 ? pageUrl(page - 1) : undefined}
        older={page < pageCount ? pageUrl(page + 1) : undefined}
      />
    </div>
  </section>
</Layout>

<style>
  .journal {
    padding-block: var(--scale-0600) var(--space-section);
  }

  /* The lead card spans the width; the rest sit in two columns, one on phones. */
  .journal__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--scale-0600);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .journal__item {
    display: flex;
  }

  .journal__item > :global(.post-card) {
    flex: 1;
  }

  .journal__item--lead {
    grid-column: 1 / -1;
  }

  @media (max-width: 599px) {
    .journal__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
