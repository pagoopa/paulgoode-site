---
// A category or a tag (Tag / Blue and Tag / Outline in design/site.pen).
// A category is the filled blue chip with the sticker outline and shadow; a tag is
// the outlined one with the quieter sticker. Both are links.
interface Props {
  href: string;
  kind: 'category' | 'tag';
}

const { href, kind } = Astro.props;
---

<a class:list={['chip', `chip--${kind}`, { 'tag-sticker': kind === 'category', 'tag-sticker-quiet': kind === 'tag' }]} href={href}><slot /></a>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    padding: var(--scale-0100) var(--scale-0300);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: var(--type-eyebrow3-size);
    line-height: var(--type-eyebrow3-line-height);
    letter-spacing: var(--type-eyebrow3-letter-spacing);
    font-weight: 500;
    text-transform: uppercase;
    text-decoration: none;
  }

  .chip--category {
    background: var(--color-accent-blue);
    color: var(--color-text-on-accent);
  }

  .chip--tag {
    background: var(--color-surface-default);
    color: var(--color-text-default);
  }

  .chip--category:hover {
    color: var(--color-text-on-accent);
    filter: brightness(0.95);
  }

  .chip--tag:hover {
    color: var(--color-text-default);
    background: var(--color-surface-hover);
  }
</style>
