---
import { Image } from 'astro:assets';
import { formatPrice, mediumKey, productUrl, type Product } from '../lib/products';

interface Props {
  product: Product;
  /** Heading level for the product name, so cards fit the page outline. */
  headingLevel?: 'h2' | 'h3';
  /** Load the image right away instead of lazily, for cards visible when the page opens. */
  eager?: boolean;
  /** Load the image ahead of everything else. Use on one card per page at most. */
  priority?: boolean;
}

const { product, headingLevel: Heading = 'h2', eager = false, priority = false } = Astro.props;
const { name, price, size, medium, signature, sold, tags, images } = product.data;
const cover = images[0];

const filterKeys = [
  ...tags,
  mediumKey(medium),
  ...(signature ? ['signature'] : []),
].join(' ');
---

<article class="product-card" data-tags={filterKeys}>
  <a class="product-card__link" href={productUrl(product)}>
    <div class="product-card__mat">
      <Image
        class="product-card__image"
        src={cover.src}
        alt={cover.alt}
        widths={[320, 480, 640]}
        sizes="(max-width: 560px) 50vw, (max-width: 960px) 33vw, 260px"
        loading={eager ? 'eager' : 'lazy'}
        priority={priority}
      />
      {sold ? (
        <span class="product-card__badge product-card__badge--sold">Sold</span>
      ) : signature ? (
        <span class="product-card__badge">Signature</span>
      ) : null}
    </div>
    <div class="product-card__body">
      <div class="product-card__row">
        <Heading class="product-card__name">{name}</Heading>
        <span class:list={['product-card__price', { 'is-sold': sold }]}>{formatPrice(price)}</span>
      </div>
      <p class="product-card__meta">{size} &middot; {medium}</p>
    </div>
  </a>
</article>

<style>
  .product-card[hidden] {
    display: none;
  }

  .product-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--scale-300);
  }

  .product-card__mat {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface-subtle);
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-card__link:hover .product-card__image {
    transform: scale(1.03);
  }

  .product-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    /* Tag / Neutral */
    background: var(--color-surface-subtle);
    color: var(--color-text-default);
    font-size: var(--type-eyebrow3-size);
    line-height: var(--type-eyebrow3-line-height);
    font-weight: 500;
    letter-spacing: var(--type-eyebrow3-letter-spacing);
    text-transform: uppercase;
    padding: var(--scale-100) var(--scale-300);
    border-radius: var(--radius-full);
  }

  .product-card__badge--sold {
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--scale-100);
  }

  .product-card__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--scale-200);
  }

  /* Headings/Header 5 */
  .product-card__name {
    font-family: var(--font-heading);
    font-size: var(--type-h5-size);
    line-height: var(--type-h5-line-height);
    font-weight: 600;
    margin: 0;
  }

  .product-card__link:hover .product-card__name {
    color: var(--color-text-link);
  }

  .product-card__price {
    font-size: var(--type-body1-size);
    line-height: var(--type-body1-line-height);
    font-weight: 500;
    color: var(--color-text-default);
  }

  .product-card__price.is-sold {
    text-decoration: line-through;
    color: var(--color-text-muted);
  }

  /* Body/body2-reg */
  .product-card__meta {
    font-size: var(--type-body2-size);
    line-height: var(--type-body2-line-height);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
