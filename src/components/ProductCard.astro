---
import { Image } from 'astro:assets';
import { formatPrice, mediumKey, productUrl, type Product } from '../lib/products';

interface Props {
  product: Product;
  /** Heading level for the product name, so cards fit the page outline. */
  headingLevel?: 'h2' | 'h3';
}

const { product, headingLevel: Heading = 'h2' } = Astro.props;
const { name, price, size, medium, signature, sold, tags, images } = product.data;
const cover = images[0];

const filterKeys = [
  ...tags,
  mediumKey(medium),
  ...(signature ? ['signature'] : []),
].join(' ');
---

<article class="product-card" data-tags={filterKeys}>
  <a class="product-card__link" href={productUrl(product)}>
    <div class="product-card__mat">
      <Image
        class="product-card__image"
        src={cover.src}
        alt={cover.alt}
        widths={[320, 480, 640]}
        sizes="(max-width: 560px) 50vw, (max-width: 960px) 33vw, 260px"
      />
      {sold ? (
        <span class="product-card__badge product-card__badge--sold">Sold</span>
      ) : signature ? (
        <span class="product-card__badge">Signature</span>
      ) : null}
    </div>
    <div class="product-card__body">
      <div class="product-card__row">
        <Heading class="product-card__name">{name}</Heading>
        <span class:list={['product-card__price', { 'is-sold': sold }]}>{formatPrice(price)}</span>
      </div>
      <p class="product-card__meta">{size} &middot; {medium}</p>
    </div>
  </a>
</article>

<style>
  .product-card[hidden] {
    display: none;
  }

  .product-card__link {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .product-card__mat {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 4px;
    overflow: hidden;
    background: #fff;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-card__link:hover .product-card__image {
    transform: scale(1.03);
  }

  .product-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--color-bg);
    color: var(--color-ink);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
  }

  .product-card__badge--sold {
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .product-card__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  .product-card__name {
    font-size: 19px;
    margin: 0;
  }

  .product-card__link:hover .product-card__name {
    color: var(--color-accent);
  }

  .product-card__price {
    font-size: 16px;
    color: var(--color-ink-muted);
  }

  .product-card__price.is-sold {
    text-decoration: line-through;
    color: var(--color-ink-faint);
  }

  .product-card__meta {
    font-size: 13px;
    color: var(--color-ink-faint);
    margin: 0;
  }

  @media (max-width: 560px) {
    .product-card__name {
      font-size: 17px;
    }

    .product-card__price {
      font-size: 14px;
    }

    .product-card__meta {
      font-size: 12px;
    }
  }
</style>
