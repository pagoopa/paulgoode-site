---
// Card / Project / Stacked and Card / Project / Side: image, eyebrow, title,
// summary and a "View …" link. The whole card is the link.
// "side" puts the image on the left; it stacks on phones.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  eyebrow?: string;
  title: string;
  summary?: string;
  linkLabel?: string;
  image?: ImageMetadata;
  // Cards link to the page, so the image is decorative unless alt is given.
  imageAlt?: string;
  layout?: 'stacked' | 'side';
  // Featured cards near the top of the page load their image straight away.
  loading?: 'eager' | 'lazy';
}

const {
  href,
  eyebrow,
  title,
  summary,
  linkLabel = 'View',
  image,
  imageAlt = '',
  layout = 'stacked',
  loading = 'lazy',
} = Astro.props;
---

<a class:list={['card', `card--${layout}`]} href={href}>
  <div class="card__media">
    {image && (
      <Image
        class="card__image"
        src={image}
        alt={imageAlt}
        widths={[360, 720]}
        sizes={layout === 'side' ? '(max-width: 599px) 100vw, 280px' : '(max-width: 599px) 100vw, 360px'}
        loading={loading}
      />
    )}
  </div>
  <div class="card__content">
    {eyebrow && <p class="card__eyebrow">{eyebrow}</p>}
    <h3 class="card__title">{title}</h3>
    {summary && <p class="card__summary">{summary}</p>}
    <span class="card__link">
      {linkLabel}
      <svg class="card__arrow" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 12h14m-6-6 6 6-6 6" />
      </svg>
    </span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xl);
    box-shadow: 0 1px 2px #121c2114;
    color: var(--color-text-default);
  }

  .card:hover {
    color: var(--color-text-default);
    border-color: var(--color-border-strong);
  }

  /* 16:10, the shape of a thumbnail (exported at 720 × 450). */
  .card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--color-surface-subtle);
  }

  /* Images fill the box without changing its size; anything taller, like full
     artwork, is cropped from the top. */
  .card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .card__content {
    display: flex;
    flex-direction: column;
    gap: var(--scale-0300);
    padding: var(--scale-0600);
  }

  .card__content > * {
    margin: 0;
  }

  /* Body/eyebrow3-md */
  .card__eyebrow {
    color: var(--color-text-link);
    font-size: var(--type-eyebrow3-size);
    line-height: var(--type-eyebrow3-line-height);
    letter-spacing: var(--type-eyebrow3-letter-spacing);
    text-transform: uppercase;
    font-weight: 500;
  }

  .card__title {
    font-size: var(--type-h4-size);
    line-height: var(--type-h4-line-height);
    letter-spacing: var(--type-h4-letter-spacing);
  }

  .card__summary {
    color: var(--color-text-muted);
    font-size: var(--type-p3-size);
    line-height: var(--type-p3-line-height);
    letter-spacing: var(--type-p3-letter-spacing);
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--scale-0200);
    padding-top: var(--scale-0100);
    font-size: var(--type-body1-size);
    line-height: var(--type-body1-line-height);
    letter-spacing: var(--type-body1-letter-spacing);
    font-weight: 500;
  }

  .card__arrow {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .card:hover .card__arrow {
    transform: translateX(2px);
  }

  /* Side: image on the left (280 wide), content on the right. */
  @media (min-width: 600px) {
    .card--side {
      flex-direction: row;
      min-height: 206px;
    }

    /* The panel is as tall as the content beside it. */
    .card--side .card__media {
      flex: none;
      width: 280px;
      aspect-ratio: auto;
    }

    .card--side .card__content {
      flex: 1;
      justify-content: center;
    }
  }
</style>
