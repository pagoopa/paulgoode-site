---
import { Image } from 'astro:assets';
import profile from '../assets/profile-circle.png';
import { navItems } from '../lib/nav';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <Image src={profile} alt="" class="site-footer__photo" width={120} height={120} />
    <nav class="site-footer__links" aria-label="Footer">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <p class="site-footer__copyright">&copy; {year} Paul Goode</p>
  </div>
</footer>

<style>
  /* Footer / Inverse: profile circle, nav links and copyright, centered */
  .site-footer {
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
    margin-top: var(--space-section);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--scale-300);
    padding-block: var(--space-block);
  }

  /* Profile / Circle with a 2px ring in the text colour */
  .site-footer__photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    outline: 2px solid var(--color-text-inverse);
    outline-offset: -2px;
  }

  /* Link / Nav / Default / Inverse; rows wrap on narrow screens */
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--scale-600);
    padding-top: var(--scale-300);
    font-size: var(--type-eyebrow2-size);
    line-height: var(--type-eyebrow2-line-height);
    letter-spacing: var(--type-eyebrow2-letter-spacing);
    text-transform: uppercase;
    font-weight: 500;
  }

  .site-footer__links a {
    padding-block: var(--scale-200);
    border-bottom: 2px solid transparent;
  }

  .site-footer__links a:hover {
    border-bottom-color: var(--color-text-inverse);
  }

  .site-footer__copyright {
    margin: 0;
    font-size: var(--type-body2-size);
    line-height: var(--type-body2-line-height);
  }

  @media (max-width: 1023px) {
    .site-footer__photo {
      width: 100px;
      height: 100px;
    }
  }

  /* Phones: Blog and Projects on the first row, the rest on the second */
  @media (max-width: 599px) {
    .site-footer__links {
      max-width: 252px;
    }
  }
</style>
