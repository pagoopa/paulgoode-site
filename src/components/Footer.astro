---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div>&copy; {year} Paul Goode</div>
    <div class="site-footer__links">
      <a href="/shop">Shop</a>
      <a href="https://www.tiktok.com/@pagoopa" target="_blank" rel="noopener noreferrer">TikTok</a>
      <a href="https://www.youtube.com/@paulgoode" target="_blank" rel="noopener noreferrer">YouTube</a>
    </div>
  </div>
</footer>

<style>
  /* Footer / Inverse (bottom row) */
  .site-footer {
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
    margin-top: var(--space-section);
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-block);
    font-size: var(--type-body2-size);
    line-height: var(--type-body2-line-height);
    flex-wrap: wrap;
    gap: var(--scale-600);
  }

  .site-footer__links {
    display: flex;
    gap: var(--scale-600);
    font-size: var(--type-eyebrow2-size);
    letter-spacing: var(--type-eyebrow2-letter-spacing);
    text-transform: uppercase;
    font-weight: 500;
  }

  .site-footer a:hover {
    color: var(--color-text-link-inverse);
  }
</style>
