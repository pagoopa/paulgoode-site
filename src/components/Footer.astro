---
import { Image } from 'astro:assets';
import profile from '../assets/profile-circle.png';
import { navItems } from '../lib/nav';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <Image src={profile} alt="" class="site-footer__photo" width={120} height={120} />
    <nav class="site-footer__links" aria-label="Footer">
      {navItems.map((item) => (
        <a href={item.href} class="link-nav">
          <span class="link-label">{item.label}</span>
        </a>
      ))}
    </nav>
    <p class="site-footer__copyright">&copy; {year} Paul Goode</p>
  </div>
</footer>

<style>
  /* Footer / Light: profile circle, nav links and copyright, centered.
     For Footer / Dark, add data-theme="dark" to the footer: it switches the
     tokens, so the same styles give a dark background and light text. */
  .site-footer {
    background: var(--color-surface-default);
    color: var(--color-text-default);
    margin-top: var(--space-section);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--scale-0300);
    padding-block: var(--space-block);
  }

  /* Profile / Circle with a 2px ring in the text colour */
  .site-footer__photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    outline: 2px solid var(--color-text-default);
    outline-offset: -2px;
  }

  /* Link / Nav / Default (styles in global.css); rows wrap on narrow screens */
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--scale-0600);
    padding-top: var(--scale-0300);
  }

  .site-footer__copyright {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--type-body2-size);
    line-height: var(--type-body2-line-height);
  }

  @media (max-width: 1023px) {
    .site-footer__photo {
      width: 100px;
      height: 100px;
    }
  }

  /* Phones: Blog and Series on the first row, the rest on the second */
  @media (max-width: 599px) {
    .site-footer__links {
      max-width: 252px;
    }
  }
</style>
