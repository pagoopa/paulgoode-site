---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div>&copy; {year} Paul Goode</div>
    <div class="site-footer__links">
      <a href="/shop">Shop</a>
      <a href="https://www.tiktok.com/@pagoopa" target="_blank" rel="noopener noreferrer">TikTok</a>
      <a href="https://www.youtube.com/@paulgoode" target="_blank" rel="noopener noreferrer">YouTube</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 96px;
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 32px;
    font-size: 14px;
    color: var(--color-ink-faint);
    flex-wrap: wrap;
    gap: 16px;
  }

  .site-footer__links {
    display: flex;
    gap: 28px;
  }
</style>
