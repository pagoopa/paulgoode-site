---
// Pagination: "Newer posts" and "Older posts" links (Pagination in
// design/site.pen). Leave a link out to hide it, e.g. no Newer on page 1.
interface Props {
  newer?: string;
  older?: string;
}

const { newer, older } = Astro.props;
---

{(newer || older) && (
  <nav class="pagination" aria-label="More posts">
    {newer && (
      <a class="link-standalone pagination__newer" href={newer} rel="prev">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M19 12H5m6 6-6-6 6-6" />
        </svg>
        <span class="link-label">Newer posts</span>
      </a>
    )}
    {older && (
      <a class="link-standalone pagination__older" href={older} rel="next">
        <span class="link-label">Older posts</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M5 12h14m-6 6 6-6-6-6" />
        </svg>
      </a>
    )}
  </nav>
)}

<style>
  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--scale-0600);
  }

  /* Older stays on the right even when there's no Newer link. */
  .pagination__older {
    margin-left: auto;
  }
</style>
