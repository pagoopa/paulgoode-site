---
// Shows a journal post on the journal page. If the post has a `<!-- more -->`
// line, only the part above it is shown, followed by a "Read more" link.
interface Props {
  href: string;
}

const { href } = Astro.props;
const html = await Astro.slots.render('default');
const cut = html.search(/<!--\s*more\s*-->/);
const excerpt = cut === -1 ? html : html.slice(0, cut);
---

<Fragment set:html={excerpt} />
{
  cut !== -1 && (
    <a class="link-standalone" href={href}>
      <span class="link-label">Read more</span>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M5 12h14m-6 6l6-6-6-6" />
      </svg>
    </a>
  )
}
