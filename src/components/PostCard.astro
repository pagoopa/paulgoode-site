---
// Card / Post and Card / Post / Lead (Concepts / Blog cards, then the Home boards in
// design/site.pen): a journal post as a card with an optional image, the date and
// category, the title, a short summary and "Read more". The whole card is the link, so
// the category is a plain chip here; its page is linked from the post and the sidebar.
// The lead card is wide, with the image on the left; it stacks on phones.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  date: Date;
  dateText: string;
  category: string;
  title: string;
  summary: string;
  image?: ImageMetadata;
  lead?: boolean;
  // The first cards on the page load their image straight away.
  loading?: 'eager' | 'lazy';
}

const { href, date, dateText, category, title, summary, image, lead = false, loading = 'lazy' } = Astro.props;
---

<a class:list={['post-card', { 'post-card--lead': lead }]} href={href}>
  <div class="post-card__media">
    {image && (
      <Image
        class="post-card__image"
        src={image}
        alt=""
        widths={lead ? [400, 800] : [374, 748]}
        sizes={lead ? '(max-width: 599px) 100vw, 400px' : '(max-width: 599px) 100vw, 374px'}
        loading={loading}
      />
    )}
  </div>
  <div class="post-card__content">
    <p class="post-card__meta">
      <time class="post-card__date" datetime={date.toISOString()}>{dateText}</time>
      <span class="post-card__category tag-sticker">{category}</span>
    </p>
    <h2 class="post-card__title">{title}</h2>
    <p class="post-card__summary">{summary}</p>
    <span class="post-card__link">
      Read more
      <svg class="post-card__arrow" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 12h14m-6-6 6 6-6 6" />
      </svg>
    </span>
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xl);
    box-shadow: 0 1px 2px #121c2114;
    color: var(--color-text-default);
  }

  .post-card:hover {
    color: var(--color-text-default);
    border-color: var(--color-border-strong);
  }

  /* 16:10, the shape of a thumbnail (exported at 748 × 468). */
  .post-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--color-surface-subtle);
  }

  .post-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .post-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--scale-0300);
    padding: var(--scale-0600);
  }

  .post-card__content > * {
    margin: 0;
  }

  /* Date, then the category chip (Tag / Blue). */
  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--scale-0300);
    font-size: var(--type-eyebrow3-size);
    line-height: var(--type-eyebrow3-line-height);
    letter-spacing: var(--type-eyebrow3-letter-spacing);
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .post-card__category {
    padding: var(--scale-0100) var(--scale-0300);
    border-radius: var(--radius-full);
    background: var(--color-accent-blue);
    color: var(--color-text-on-accent);
  }

  .post-card__title {
    font-size: var(--type-h4-size);
    line-height: var(--type-h4-line-height);
    letter-spacing: var(--type-h4-letter-spacing);
  }

  .post-card__summary {
    color: var(--color-text-muted);
    font-size: var(--type-p3-size);
    line-height: var(--type-p3-line-height);
    letter-spacing: var(--type-p3-letter-spacing);
  }

  .post-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--scale-0200);
    padding-top: var(--scale-0100);
    font-size: var(--type-body1-size);
    line-height: var(--type-body1-line-height);
    letter-spacing: var(--type-body1-letter-spacing);
    font-weight: 500;
  }

  .post-card__arrow {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .post-card:hover .post-card__arrow {
    transform: translateX(2px);
  }

  /* Lead: image on the left (300 wide on tablets, 400 on desktop), the text beside it. */
  @media (min-width: 600px) {
    .post-card--lead {
      flex-direction: row;
    }

    .post-card--lead .post-card__media {
      flex: none;
      width: 300px;
      aspect-ratio: auto;
    }

    .post-card--lead .post-card__content {
      justify-content: center;
      padding: var(--scale-0800);
    }

    .post-card--lead .post-card__title {
      font-size: var(--type-h3-size);
      line-height: var(--type-h3-line-height);
      letter-spacing: var(--type-h3-letter-spacing);
    }

    .post-card--lead .post-card__summary {
      font-size: var(--type-p2-size);
      line-height: var(--type-p2-line-height);
      letter-spacing: var(--type-p2-letter-spacing);
    }
  }

  @media (min-width: 1024px) {
    .post-card--lead .post-card__media {
      width: 400px;
    }
  }
</style>
