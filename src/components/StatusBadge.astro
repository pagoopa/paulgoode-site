---
// Tag from design/site.pen, used for a series status.
// exploring is Tag / Outline, active is Yellow, resting is Neutral,
// complete is Blue, and promoted is Pink.
import type { SeriesStatus } from '../lib/labels';

interface Props {
  status: SeriesStatus;
}

const labels: Record<SeriesStatus, string> = {
  exploring: 'Exploring',
  active: 'Active',
  resting: 'Resting',
  complete: 'Complete',
  promoted: 'Promoted',
};

const { status } = Astro.props;
---

<span class:list={['status', `status--${status}`]}>{labels[status]}</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    padding: var(--scale-0100) var(--scale-0300);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: var(--type-eyebrow3-size);
    line-height: var(--type-eyebrow3-line-height);
    letter-spacing: var(--type-eyebrow3-letter-spacing);
    font-weight: 500;
    text-transform: uppercase;
  }

  .status--active {
    background: var(--color-accent-yellow);
    color: var(--color-text-on-accent);
  }

  .status--complete {
    background: var(--color-accent-blue);
    color: var(--color-text-on-accent);
  }

  .status--promoted {
    background: var(--color-accent-pink);
    color: var(--color-text-on-accent);
  }

  .status--resting {
    background: var(--color-surface-subtle);
    color: var(--color-text-default);
  }

  .status--exploring {
    color: var(--color-text-default);
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
  }
</style>
