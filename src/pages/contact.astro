---
import Layout from '../layouts/Layout.astro';
import PageActions from '../components/PageActions.astro';
import { getPage } from '../lib/pages';

// Copy lives in src/content/pages/contact.md.
const { data, Content } = await getPage('contact');
---

<Layout title={data.title} description={data.description}>
  <section class="wrap prose contact">
    {data.eyebrow && <p class="eyebrow">{data.eyebrow}</p>}
    <h1>{data.heading}</h1>
    <Content />
    <PageActions class="contact__actions" actions={data.actions} />
  </section>
</Layout>

<style>
  .contact {
    padding-block: 64px 96px;
  }

  .contact :global(.contact__actions) {
    margin-top: 12px;
  }
</style>
