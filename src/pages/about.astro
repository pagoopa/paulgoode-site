---
import Layout from '../layouts/Layout.astro';
import PageActions from '../components/PageActions.astro';
import { getPage } from '../lib/pages';

// Copy lives in src/content/pages/about.md.
const { data, Content } = await getPage('about');
---

<Layout title={data.title} description={data.description}>
  <section class="wrap prose about">
    {data.eyebrow && <p class="eyebrow">{data.eyebrow}</p>}
    <h1>{data.heading}</h1>
    <Content />
    <PageActions actions={data.actions} />
  </section>
</Layout>

<style>
  .about {
    padding-block: 64px 96px;
  }
</style>
