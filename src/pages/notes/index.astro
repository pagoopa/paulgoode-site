---
// Sample notes, newest first. Content lives in src/content/notes/.
import Layout from '../../layouts/Layout.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const entries = await Promise.all(
  notes.map(async (note) => ({
    note,
    Content: (await render(note)).Content,
    images: await Promise.all(
      note.data.images.map(async (image) => ({
        alt: image.alt,
        full: (await getImage({ src: image.src, width: 1600 })).src,
        thumb: image.src,
      })),
    ),
  })),
);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Layout title="Notes" description="Notes from the studio, the walks, and the work.">
  <section class="wrap notes">
    <p class="eyebrow">Notes</p>
    <h1>Recent notes</h1>
    <ul class="notes__list">
      {entries.map(({ note, Content, images }) => (
        <li class="notes__item">
          <time datetime={note.data.date.toISOString()}>{dateFmt.format(note.data.date)}</time>
          <div class="notes__body">
            <Content />
          </div>
          {images.length > 0 && (
            <div class="notes__images">
              {images.map((image, index) => (
                <button
                  type="button"
                  class="notes__photo"
                  data-index={index}
                  data-src={image.full}
                  data-alt={image.alt}
                  aria-label={`Open image: ${image.alt}`}
                >
                  <Image src={image.thumb} alt="" width={640} densities={[1, 2]} />
                </button>
              ))}
            </div>
          )}
        </li>
      ))}
    </ul>
  </section>

  <div class="lightbox" hidden>
    <button type="button" class="lightbox__control lightbox__close" data-lightbox-close aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <button type="button" class="lightbox__control lightbox__prev" data-lightbox-prev aria-label="Previous" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 6.5L8 12l6.5 5.5" /></svg>
    </button>
    <img class="lightbox__photo" alt="" />
    <button type="button" class="lightbox__control lightbox__next" data-lightbox-next aria-label="Next" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 6.5L16 12l-6.5 5.5" /></svg>
    </button>
  </div>
</Layout>

<script>
  const lightbox = document.querySelector<HTMLElement>('.lightbox');
  const photo = lightbox?.querySelector<HTMLImageElement>('.lightbox__photo');
  const prev = lightbox?.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
  const next = lightbox?.querySelector<HTMLButtonElement>('[data-lightbox-next]');
  const close = lightbox?.querySelector<HTMLButtonElement>('[data-lightbox-close]');

  let group: HTMLButtonElement[] = [];
  let index = 0;

  function openAt(i: number) {
    if (!lightbox || !photo || !prev || !next) return;
    index = i;
    const button = group[index];
    photo.src = button.dataset.src ?? '';
    photo.alt = button.dataset.alt ?? '';
    prev.hidden = index === 0;
    next.hidden = index === group.length - 1;
    lightbox.hidden = false;
    document.body.classList.add('lightbox-open');
    close?.focus();
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.classList.remove('lightbox-open');
    if (photo) photo.removeAttribute('src');
  }

  document.querySelectorAll<HTMLButtonElement>('.notes__photo').forEach((button) => {
    button.addEventListener('click', () => {
      const strip = button.closest('.notes__images');
      group = strip ? [...strip.querySelectorAll<HTMLButtonElement>('.notes__photo')] : [button];
      openAt(group.indexOf(button));
    });
  });

  prev?.addEventListener('click', () => index > 0 && openAt(index - 1));
  next?.addEventListener('click', () => index < group.length - 1 && openAt(index + 1));
  close?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (event) => {
    if (!lightbox || lightbox.hidden) return;
    if (event.key === 'Escape') closeLightbox();
    if (event.key === 'ArrowLeft' && index > 0) openAt(index - 1);
    if (event.key === 'ArrowRight' && index < group.length - 1) openAt(index + 1);
  });
</script>

<style>
  .notes {
    padding-block: var(--space-section);
    max-width: 720px;
  }

  .notes__list {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--scale-0900);
  }

  .notes__item {
    display: flex;
    flex-direction: column;
    gap: var(--scale-0400);
    padding-bottom: var(--scale-0600);
    border-bottom: 1px solid var(--color-border-default);
  }

  .notes__images {
    display: flex;
    gap: var(--scale-0200);
    overflow: auto;
  }

  .notes__photo {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: var(--radius-lg);
    appearance: none;
  }

  .notes__photo:focus-visible {
    outline: 2px solid var(--color-text-link);
    outline-offset: 3px;
  }

  .notes__images :global(img) {
    width: auto;
    height: 280px;
    border-radius: var(--radius-lg);
    display: block;
  }

  .lightbox {
    position: fixed;
    z-index: 40;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 88px;
    background: #0c1216f2;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox__photo {
    max-width: min(920px, 100%);
    max-height: calc(100vh - 96px);
    object-fit: contain;
    border-radius: 0;
  }

  .lightbox__control {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #3c444ce6;
    color: #fff;
    cursor: pointer;
    appearance: none;
  }

  .lightbox__control[hidden] {
    display: none;
  }

  .lightbox__control svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lightbox__close {
    top: 24px;
    left: 24px;
    background: #5a636ce6;
  }

  .lightbox__prev {
    top: 50%;
    left: 24px;
    translate: 0 -50%;
  }

  .lightbox__next {
    top: 50%;
    right: 24px;
    translate: 0 -50%;
  }

  :global(body.lightbox-open) {
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .lightbox {
      padding: 16px;
    }

    .lightbox__photo {
      max-width: 100%;
      max-height: calc(100vh - 32px);
    }

    .lightbox__close,
    .lightbox__prev {
      left: 12px;
    }

    .lightbox__next {
      right: 12px;
    }
  }
</style>
