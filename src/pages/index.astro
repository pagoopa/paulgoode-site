---
import Layout from '../layouts/Layout.astro';
import PageActions from '../components/PageActions.astro';
import { getPage } from '../lib/pages';

// Copy lives in src/content/pages/home.md.
const { data, Content } = await getPage('home');
---

<Layout title={data.title} description={data.description}>
  <section class="wrap hero">
    {data.eyebrow && <p class="eyebrow">{data.eyebrow}</p>}
    <h1>{data.heading}</h1>
    <div class="hero__lede prose">
      <Content />
    </div>
    <PageActions class="hero__actions" actions={data.actions} />
  </section>
</Layout>

<style>
  .hero {
    padding-block: var(--space-section) var(--space-block);
    max-width: 720px;
  }

  /* Headings/Display 3 */
  .hero h1 {
    font-family: var(--font-display);
    font-size: var(--type-display-3-size);
    line-height: var(--type-display-3-line-height);
    letter-spacing: var(--type-display-3-letter-spacing);
    margin-block: var(--space-stack);
  }

  /* Body/p1-reg */
  .hero__lede {
    font-size: var(--type-p1-size);
    line-height: var(--type-p1-line-height);
    color: var(--color-text-muted);
  }

  .hero__lede :global(p:last-child) {
    margin-bottom: 0;
  }

  .hero :global(.hero__actions) {
    margin-top: var(--scale-800);
  }
</style>
