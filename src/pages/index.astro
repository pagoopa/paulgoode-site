---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <section class="wrap hero">
    <p class="eyebrow">Founder, Uplifting Ink</p>
    <h1>Drawing is thinking.</h1>
    <p class="hero__lede prose">
      UX designer, artist, and musician working across product design and
      original art. This is where the process is visible — sketches, shop
      pieces, and the journal, all in one place.
    </p>
    <div class="hero__actions">
      <a class="btn btn-solid" href="/shop">View the shop</a>
      <a class="btn" href="/blog">Read the journal</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: var(--space-section) var(--space-block);
    max-width: 720px;
  }

  /* Headings/Display 3 */
  .hero h1 {
    font-family: var(--font-display);
    font-size: var(--type-display-3-size);
    line-height: var(--type-display-3-line-height);
    letter-spacing: var(--type-display-3-letter-spacing);
    margin-block: var(--space-stack);
  }

  /* Body/p1-reg */
  .hero__lede {
    font-size: var(--type-p1-size);
    line-height: var(--type-p1-line-height);
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    gap: var(--scale-400);
    margin-top: var(--scale-800);
  }
</style>
