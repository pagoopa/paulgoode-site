---
// A project's own page: its type, title and summary, then the write-up.
// URL: /projects/<project>. The copy lives in src/content/projects/<project>.md.
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { render } from 'astro:content';
import { getProjects } from '../../lib/projects';
import { projectTypes } from '../../lib/labels';

export async function getStaticPaths() {
  const { all } = await getProjects();
  return all.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, type } = project.data;
---

<Layout title={title} description={summary}>
  <article class="wrap project">
    <SectionHeader eyebrow={projectTypes[type].eyebrow} title={title} intro={summary} level="h1" />
    <div class="prose">
      <Content />
    </div>
    <a class="link-standalone" href="/projects">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M19 12H5m6 6-6-6 6-6" />
      </svg>
      <span class="link-label">All projects</span>
    </a>
  </article>
</Layout>

<style>
  .project {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-block);
    padding-block: var(--space-section);
  }
</style>
