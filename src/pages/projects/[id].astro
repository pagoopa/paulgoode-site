---
// A project's own page: its type, title and summary, then the write-up.
// URL: /projects/<project>. The copy lives in src/content/projects/<project>.md.
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import BackLink from '../../components/BackLink.astro';
import { render } from 'astro:content';
import { getProjects } from '../../lib/projects';
import { projectTypes } from '../../lib/labels';

export async function getStaticPaths() {
  const { all } = await getProjects();
  // A series project has no page of its own: its card links to the series landing page.
  return all.filter((project) => !project.data.series).map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, type } = project.data;
---

<Layout title={title} description={summary} sidebar={project.data.sidebar} sidebarHide={project.data.sidebarHide}>
  <article class="wrap project">
    <SectionHeader eyebrow={projectTypes[type].eyebrow} title={title} intro={summary} level="h1" />
    <div class="prose">
      <Content />
    </div>
    <BackLink href="/projects" label="Back to Projects" />
  </article>
</Layout>

<style>
  .project {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-block);
    padding-block: var(--space-section);
  }
</style>
