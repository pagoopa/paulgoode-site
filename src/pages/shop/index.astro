---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProducts, mediumKey } from '../../lib/products';

const products = await getProducts();

// Filters are derived from the product data, so a filter only appears when at
// least one piece matches it. Add `tags: [pattern]` etc. to a product's
// frontmatter to bring back subject filters.
const tagLabels: Record<string, string> = {
  pattern: 'Pattern',
  landscape: 'Landscape',
  creature: 'Creature',
};
const titleCase = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const tagIds = [...new Set(products.flatMap((p) => p.data.tags))];
const mediumIds = [...new Set(products.map((p) => mediumKey(p.data.medium)))];

const filters = [
  { id: 'all', label: 'All' },
  ...(products.some((p) => p.data.signature) ? [{ id: 'signature', label: 'Signature Work' }] : []),
  ...tagIds.map((id) => ({ id, label: tagLabels[id] ?? titleCase(id) })),
  ...(mediumIds.length > 1 ? mediumIds.map((id) => ({ id, label: titleCase(id) })) : []),
];
---

<Layout title="Shop" description="Original acrylic and ink works on paper by Paul Goode.">
  <section class="wrap intro">
    <p class="eyebrow">Originals</p>
    <h1>Drawing is thinking, framed.</h1>
    <p class="intro__lede prose">
      One-of-a-kind acrylic and ink works on paper, 22&Prime; &times; 30&Prime;.
      Checkout is handled securely through Stripe &mdash; each piece ships once,
      direct from the studio.
    </p>
  </section>

  <section class="wrap filter-bar">
    <div class="filter-bar__pills" role="group" aria-label="Filter by category">
      {filters.map((f, i) => (
        <button
          type="button"
          class="pill"
          data-filter={f.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {f.label}
        </button>
      ))}
    </div>
    <div class="filter-bar__count" data-result-count aria-live="polite"></div>
  </section>

  <section class="wrap product-grid">
    {products.map((p) => <ProductCard product={p} />)}
  </section>

  <p class="wrap empty-state" data-empty-state hidden>No pieces match that filter yet.</p>
</Layout>

<style>
  /* Section header / Left */
  .intro {
    padding-block: var(--space-section) var(--space-block);
  }

  .intro h1 {
    font-size: var(--type-h2-size);
    line-height: var(--type-h2-line-height);
    margin-block: var(--space-stack);
  }

  /* Body/p1-reg */
  .intro__lede {
    font-size: var(--type-p1-size);
    line-height: var(--type-p1-line-height);
    color: var(--color-text-muted);
    max-width: 720px;
  }

  .filter-bar {
    padding-block: 0 var(--space-block);
    display: flex;
    align-items: center;
    gap: var(--scale-300);
    flex-wrap: wrap;
  }

  .filter-bar__pills {
    display: flex;
    gap: var(--scale-200);
    flex-wrap: wrap;
  }

  /* Tag / Outline; the active filter is Tag / Yellow */
  .pill {
    font-family: var(--font-body);
    font-size: var(--type-eyebrow3-size);
    line-height: var(--type-eyebrow3-line-height);
    letter-spacing: var(--type-eyebrow3-letter-spacing);
    text-transform: uppercase;
    font-weight: 500;
    border-radius: var(--radius-full);
    padding: var(--scale-100) var(--scale-300);
    cursor: pointer;
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-text-default);
  }

  .pill:hover {
    background: var(--color-surface-hover);
  }

  .pill[aria-pressed='true'] {
    border-color: var(--color-accent-yellow);
    background: var(--color-accent-yellow);
    color: var(--color-text-on-accent);
  }

  .filter-bar__count {
    margin-left: auto;
    font-size: var(--type-body2-size);
    color: var(--color-text-muted);
  }

  .product-grid {
    padding-block: 0 var(--space-section);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-block) var(--layout-gutter);
  }

  .empty-state {
    padding-block: 0 var(--space-section);
    color: var(--color-text-muted);
  }

  @media (max-width: 1023px) {
    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 599px) {
    .filter-bar__count {
      margin-left: 0;
      width: 100%;
    }
  }
</style>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.pill');
  const cards = document.querySelectorAll<HTMLElement>('.product-card');
  const countEl = document.querySelector<HTMLElement>('[data-result-count]');
  const emptyEl = document.querySelector<HTMLElement>('[data-empty-state]');

  function applyFilter(filterId: string) {
    let visibleCount = 0;

    cards.forEach((card) => {
      const tags = (card.dataset.tags ?? '').split(' ').filter(Boolean);
      const matches = filterId === 'all' || tags.includes(filterId);
      card.hidden = !matches;
      if (matches) visibleCount += 1;
    });

    if (countEl) {
      const activeLabel = document.querySelector<HTMLElement>(`.pill[data-filter="${filterId}"]`)?.textContent?.trim();
      const noun = visibleCount === 1 ? 'piece' : 'pieces';
      countEl.textContent = filterId === 'all'
        ? `${visibleCount} ${noun}`
        : `${visibleCount} ${noun} · ${activeLabel}`;
    }

    if (emptyEl) {
      emptyEl.hidden = visibleCount !== 0;
    }
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pills.forEach((p) => p.setAttribute('aria-pressed', 'false'));
      pill.setAttribute('aria-pressed', 'true');
      applyFilter(pill.dataset.filter ?? 'all');
    });
  });

  applyFilter('all');
</script>
