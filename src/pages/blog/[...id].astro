---
// One journal post. Matches the Post boards in design/site.pen: the title, the
// date and category, the body between two lines, the category and tags, then
// links to the newer and older posts.
import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/Pagination.astro';
import TagChip from '../../components/TagChip.astro';
import { render } from 'astro:content';
import { getJournalPosts, postDateFormat } from '../../lib/blog';
import { categoryLabel, categoryUrl, tagUrl } from '../../lib/taxonomy';

export async function getStaticPaths() {
  // Newest first, so the post before this one is newer and the one after is older.
  const posts = await getJournalPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const postUrl = (p: typeof post) => `/blog/${p.id}/`;
const { category, tags } = post.data;
---

<Layout
  title={post.data.title}
  ogType="article"
  description={post.data.description}
  sidebar={post.data.sidebar}
  sidebarHide={post.data.sidebarHide}
>
  <div class="wrap post">
    <div class="entry-column">
      <article class="entry">
        <h1 class="entry__title">{post.data.title}</h1>
        <div class="entry__meta">
          <time class="entry__date" datetime={post.data.pubDate.toISOString()}>
            {postDateFormat.format(post.data.pubDate)}
          </time>
          <TagChip kind="category" href={categoryUrl(category)}>{categoryLabel(category)}</TagChip>
        </div>
        <div class="entry__body">
          <Content />
        </div>
        <div class="entry__filed">
          <div class="entry__filed-row">
            <div class="entry__filed-group">
              <span class="entry__filed-label">Filed under</span>
              <TagChip kind="category" href={categoryUrl(category)}>{categoryLabel(category)}</TagChip>
            </div>
            <a class="link-standalone" href="/tags/">
              <span class="link-label">All tags</span>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path d="M5 12h14m-6 6l6-6-6-6" />
              </svg>
            </a>
          </div>
          {tags.length > 0 && (
            <ul class="entry__tags" aria-label="Tags">
              {tags.map((tag) => (
                <li>
                  <TagChip kind="tag" href={tagUrl(tag)}>{tag}</TagChip>
                </li>
              ))}
            </ul>
          )}
        </div>
      </article>

      <Pagination
        newer={newer && postUrl(newer)}
        older={older && postUrl(older)}
        newerLabel="Newer post"
        olderLabel="Older post"
      />
    </div>
  </div>
</Layout>

<style>
  .post {
    padding-block: var(--scale-0600) var(--space-section);
  }
</style>
