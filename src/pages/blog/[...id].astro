---
// One journal post. Matches the Post boards in design/site.pen: the title, the
// date, the body between two lines, then links to the newer and older posts.
import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/Pagination.astro';
import { render } from 'astro:content';
import { getJournalPosts, postDateFormat } from '../../lib/blog';

export async function getStaticPaths() {
  // Newest first, so the post before this one is newer and the one after is older.
  const posts = await getJournalPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const postUrl = (p: typeof post) => `/blog/${p.id}/`;
---

<Layout title={post.data.title} description={post.data.description}>
  <div class="wrap post">
    <div class="entry-column">
      <article class="entry">
        <h1 class="entry__title">{post.data.title}</h1>
        <time class="entry__date" datetime={post.data.pubDate.toISOString()}>
          {postDateFormat.format(post.data.pubDate)}
        </time>
        <div class="entry__body">
          <Content />
        </div>
      </article>

      <Pagination
        newer={newer && postUrl(newer)}
        older={older && postUrl(older)}
        newerLabel="Newer post"
        olderLabel="Older post"
      />
    </div>
  </div>
</Layout>

<style>
  .post {
    padding-block: var(--scale-0600) var(--space-section);
  }
</style>
