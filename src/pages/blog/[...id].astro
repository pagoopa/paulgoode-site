---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { sidebarImage } = post.data;

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  // pubDate is midnight UTC; without this it shows the day before in US time zones.
  timeZone: 'UTC',
});
---

<Layout title={post.data.title} description={post.data.description}>
  <div class="wrap post">
    <div class:list={['post__content', { 'post__content--with-image': sidebarImage }]}>
      {sidebarImage && (
        <div class="post__aside">
          <Image
            class="post__image"
            src={sidebarImage.src}
            alt={sidebarImage.alt}
            width={240}
            widths={[240, 480]}
            sizes="240px"
            loading="eager"
            priority
          />
        </div>
      )}
      <article class="post__article">
        <p class="eyebrow">{dateFmt.format(post.data.pubDate)}</p>
        <h1>{post.data.title}</h1>
        <div class="post__body">
          <Content />
        </div>
      </article>
    </div>
  </div>
</Layout>

<style>
  .post {
    padding-block: var(--space-block) var(--space-section);
  }

  .post__content {
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .post__content--with-image {
    display: flex;
    gap: var(--scale-0600);
  }

  /* 240×300 portrait. On desktop it drops 40px to sit level with the title. */
  .post__aside {
    flex: none;
    padding-top: 40px;
  }

  .post__image {
    display: block;
    width: 240px;
    height: 300px;
    object-fit: cover;
  }

  .post__article {
    flex: 1;
    min-width: 0;
  }

  .post__body {
    margin-top: var(--scale-0800);
    font-size: var(--type-p2-size);
    line-height: var(--type-p2-line-height);
  }

  .post__body :global(p) {
    margin-bottom: 1.4em;
  }

  @media (max-width: 1023px) {
    .post__aside {
      padding-top: 0;
    }
  }

  /* Mobile: the image stacks above the entry, centered. */
  @media (max-width: 599px) {
    .post__content--with-image {
      flex-direction: column;
      align-items: center;
    }

    .post__article {
      align-self: stretch;
    }
  }
</style>
