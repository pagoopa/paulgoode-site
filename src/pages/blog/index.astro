---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const isDev = import.meta.env.DEV;
const allPosts = await getCollection('blog', ({ data }) => isDev || !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title="Journal" description="Keep Going Sketchbook — an open creative journal.">
  <section class="wrap journal">
    <p class="eyebrow">Journal</p>
    <h1>Keep Going Sketchbook</h1>

    {posts.length === 0 && <p class="prose">Nothing published yet.</p>}

    <ul class="journal__list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="journal__item">
            <span class="journal__date">{dateFmt.format(post.data.pubDate)}</span>
            <h2 class="journal__title">{post.data.title}</h2>
            {post.data.description && <p class="journal__desc">{post.data.description}</p>}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .journal {
    padding-block: 64px 96px;
    max-width: 720px;
  }

  .journal__list {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .journal__item {
    display: block;
    padding-block: 24px;
    border-bottom: 1px solid var(--color-border);
  }

  .journal__date {
    font-size: 13px;
    color: var(--color-ink-faint);
  }

  .journal__title {
    font-size: 24px;
    margin: 4px 0 6px;
  }

  .journal__desc {
    color: var(--color-ink-muted);
    margin: 0;
  }
</style>
